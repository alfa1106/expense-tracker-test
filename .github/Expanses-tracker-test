    // ===== Export =====
    function downloadFile(filename, content, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function exportJSON() {
      const data = {
        exportedAt: new Date().toISOString(),
        budget: budget,
        transactions: transactions
      };
      const json = JSON.stringify(data, null, 2);
      const date = new Date().toISOString().slice(0, 10);
      downloadFile(`expense-backup-${date}.json`, json, "application/json");
    }

    function exportCSV() {
      const headers = ["Type", "Amount", "Category", "Note", "Date", "Time", "Latitude", "Longitude", "Address"];
      const rows = transactions
        .slice()
        .sort((a, b) => a.createdAt - b.createdAt)
        .map(t => {
          const d = new Date(t.createdAt);
          const date = d.toLocaleDateString("en-CA"); // YYYY-MM-DD
          const time = d.toLocaleTimeString("en", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
          const lat = t.location?.lat ?? "";
          const lng = t.location?.lng ?? "";
          const address = (t.location?.address || "").replace(/"/g, '""');
          const note = (t.note || "").replace(/"/g, '""');
          const category = t.category || "";
          return [
            t.type,
            t.amount,
            category,
            `"${note}"`,
            date,
            time,
            lat,
            lng,
            `"${address}"`
          ].join(",");
        });

      const csv = [headers.join(","), ...rows].join("\n");
      const date = new Date().toISOString().slice(0, 10);
      downloadFile(`expense-export-${date}.csv`, csv, "text/csv;charset=utf-8");
    }

    document.getElementById("exportJsonBtn").addEventListener("click", exportJSON);
    document.getElementById("exportCsvBtn").addEventListener("click", exportCSV);

