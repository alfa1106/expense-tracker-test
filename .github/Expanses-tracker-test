    importFile.addEventListener("change", (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target.result);

          // Support both full backup format and plain array
          let importedTransactions = [];
          let importedBudget = budget;

          if (Array.isArray(data)) {
            importedTransactions = data;
          } else if (data && typeof data === "object") {
            if (Array.isArray(data.transactions)) {
              importedTransactions = data.transactions;
            }
            if (typeof data.budget === "number") {
              importedBudget = data.budget;
            }
          } else {
            throw new Error("Invalid backup format");
          }

          // Basic validation
          importedTransactions = importedTransactions.filter(t =>
            t && typeof t.amount === "number" && t.createdAt && (t.type === "expense" || t.type === "income")
          );

          if (importedTransactions.length === 0 && importedBudget === budget) {
            alert("No valid data found in this file.");
            return;
          }

          const confirmMsg = `Restore backup?\n\n` +
            `• Transactions: ${importedTransactions.length}\n` +
            `• Budget: Rp ${Number(importedBudget).toLocaleString("id-ID")}\n\n` +
            `This will replace your current data.`;

          if (!confirm(confirmMsg)) {
            importFile.value = "";
            return;
          }

          transactions = importedTransactions;
          budget = importedBudget;
          save();
          render();
          alert("Backup restored successfully!");
        } catch (err) {
          console.error(err);
          alert("Could not read this file. Please select a valid JSON backup.");
        }
        importFile.value = "";
      };
      reader.readAsText(file);
    });

